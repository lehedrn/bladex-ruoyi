# ==========================================
# BladeX-RuoYi 项目 .gitignore
# 覆盖 Maven/Java、Node.js/前端、IDE、OS 等
# ==========================================

# Java / Maven
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.log
*.jar.original
dependency-reduced-pom.xml
!mvnw
!mvnw.cmd
!.mvn/

# Gradle (如有)
.gradle/
build/
out/

# Node.js / 前端
node_modules/
dist/
.next/
.nuxt/
.output/
.cache/
.npm/
.eslintcache
package-lock.json

# IDE - IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# IDE - Eclipse
.classpath
.project
.settings/
bin/

# IDE - VS Code
.vscode/
*.code-workspace

# IDE - NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp

# Environment & Secrets
.env
.env.*
*.local
application-local.yml
application-local.properties

# Database
*.db
*.sqlite
*.h2.db

# Docker (本地调试用，如需提交则移除)
.docker/

# Claude Code 本地配置
.claude/

# Misc
*.bak
*.orig
*.rej
.DS_Store
*.patch
coverage/
.nyc_output/
