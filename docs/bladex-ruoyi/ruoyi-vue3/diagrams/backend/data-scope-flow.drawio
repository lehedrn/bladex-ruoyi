<mxfile host="ruoyi-architecture-analysis">
  <diagram id="data-scope-flow" name="数据权限流程图">
    <mxGraphModel dx="1422" dy="766" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="2" value="Service 方法调用" style="shape=mxgraph.flowchart.start_1;whiteSpace=wrap;html=1;fillColor=#b3e5fc;strokeColor=#0288d1;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="20" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- @DataScope 注解 -->
        <mxCell id="3" value="方法标注 @DataScope(deptAlias=&quot;d&quot;, userAlias=&quot;u&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="350" y="100" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- DataScopeAspect 拦截 -->
        <mxCell id="4" value="DataScopeAspect 拦截 (Order=最高)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="185" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- 判断: 超级管理员 -->
        <mxCell id="5" value="是否超级管理员 (admin)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="370" y="265" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- 是: 跳过 -->
        <mxCell id="6" value="是: 跳过数据权限过滤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#66bb6a;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="680" y="280" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- 否: 获取角色权限 -->
        <mxCell id="7" value="否: 获取当前用户的角色列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="370" y="365" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- 获取角色 dataScope -->
        <mxCell id="8" value="遍历角色, 获取最小 dataScope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="370" y="430" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- 5 级判断 -->
        <mxCell id="9" value="dataScope 分级判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="370" y="500" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- 5 级说明 -->
        <mxCell id="10" value="1: 全部数据权限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="50" y="600" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="11" value="2: 自定数据权限 (按部门)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="50" y="645" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="12" value="3: 本部门数据权限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="50" y="690" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="13" value="4: 本部门及以下" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="50" y="735" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="14" value="5: 仅本人数据权限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="50" y="780" width="180" height="35" as="geometry" />
        </mxCell>

        <!-- SQL 拼接 -->
        <mxCell id="15" value="SQL WHERE 动态拼接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66bb6a;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="620" width="360" height="175" as="geometry" />
        </mxCell>
        <mxCell id="16" value="dataScope=1: 不拼接 (全部数据)" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="635" width="340" height="25" as="geometry" />
        </mxCell>
        <mxCell id="17" value="dataScope=2: AND d.dept_id IN (SELECT dept_id FROM sys_role_dept WHERE role_id = ?)" style="text;html=1;align=left;fontSize=10;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="660" width="340" height="25" as="geometry" />
        </mxCell>
        <mxCell id="18" value="dataScope=3: AND d.dept_id = ? (当前用户部门ID)" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="685" width="340" height="25" as="geometry" />
        </mxCell>
        <mxCell id="19" value="dataScope=4: AND d.dept_id IN (SELECT dept_id FROM sys_dept WHERE ancestors LIKE '%{deptId}%')" style="text;html=1;align=left;fontSize=10;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="710" width="340" height="25" as="geometry" />
        </mxCell>
        <mxCell id="20" value="dataScope=5: AND u.user_id = ? (当前用户ID)" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="735" width="340" height="25" as="geometry" />
        </mxCell>
        <mxCell id="21" value="params.put(&quot;dataScope&quot;, sqlString)" style="text;html=1;align=left;fontSize=11;spacingLeft=10;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="310" y="760" width="340" height="25" as="geometry" />
        </mxCell>

        <!-- Mapper 执行 -->
        <mxCell id="22" value="Mapper 执行 SQL (MyBatis ${dataScope})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b3e5fc;strokeColor=#0288d1;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="350" y="830" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- 返回结果 -->
        <mxCell id="23" value="返回过滤后的数据" style="shape=mxgraph.flowchart.start_1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#66bb6a;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="910" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 连线 -->
        <mxCell id="24" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="2" target="3" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="70" as="sourcePoint" />
            <mxPoint x="480" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="25" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="3" target="4" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="155" as="sourcePoint" />
            <mxPoint x="480" y="185" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="26" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="4" target="5" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="235" as="sourcePoint" />
            <mxPoint x="480" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="27" value="是" style="endArrow=block;html=1;strokeColor=#66bb6a;entryX=0;entryY=0.5;exitX=1;exitY=0.5;rounded=0;" parent="1" source="5" target="6" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="590" y="300" as="sourcePoint" />
            <mxPoint x="680" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="28" value="否" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="5" target="7" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="335" as="sourcePoint" />
            <mxPoint x="480" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="29" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="7" target="8" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="405" as="sourcePoint" />
            <mxPoint x="480" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="30" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="8" target="9" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="470" as="sourcePoint" />
            <mxPoint x="480" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="31" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="9" target="15" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="570" as="sourcePoint" />
            <mxPoint x="480" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="32" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="15" target="22" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="795" as="sourcePoint" />
            <mxPoint x="480" y="830" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="33" value="" style="endArrow=block;html=1;strokeColor=#333333;entryX=0.5;entryY=0;exitX=0.5;exitY=1;rounded=0;" parent="1" source="22" target="23" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="880" as="sourcePoint" />
            <mxPoint x="480" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
