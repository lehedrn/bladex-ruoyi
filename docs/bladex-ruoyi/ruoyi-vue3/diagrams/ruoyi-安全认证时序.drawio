        </mxCell>
        <mxCell id="45" value="18. verifyToken() — 过期续期检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
