        <mxCell id="40" value="── 请求认证流程 (带 Token 的请求) ──" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fontSize=13;fontColor=#333;fontStyle=2;" parent="1" vertex="1">
