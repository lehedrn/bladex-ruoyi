        </mxCell>
        <mxCell id="30" value="9. 存入 Redis login_tokens:{uuid}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;edgeStyle=elbowEdgeStyle;elbow=vertical;dashed=1;" parent="1" source="14" target="15" edge="1">
          <mxGeometry relative="1" as="geometry" />
