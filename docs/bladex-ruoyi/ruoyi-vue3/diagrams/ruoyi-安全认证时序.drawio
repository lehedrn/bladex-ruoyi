        </mxCell>
        <mxCell id="44" value="17. 从 Redis 获取 LoginUser" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;edgeStyle=elbowEdgeStyle;elbow=vertical;dashed=1;" parent="1" source="14" target="15" edge="1">
