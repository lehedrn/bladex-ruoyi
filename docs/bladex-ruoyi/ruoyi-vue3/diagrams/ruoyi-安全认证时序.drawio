        </mxCell>
        <mxCell id="41" value="14. GET /system/user/list + Authorization: Bearer {JWT}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;edgeStyle=elbowEdgeStyle;elbow=vertical;" parent="1" source="10" target="11" edge="1">
