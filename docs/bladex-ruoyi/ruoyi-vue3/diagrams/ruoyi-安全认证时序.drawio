          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" value="3. validateCaptcha() — 验证码校验" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;edgeStyle=elbowEdgeStyle;elbow=vertical;dashed=1;" parent="1" source="12" target="15" edge="1">
