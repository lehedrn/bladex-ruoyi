        </mxCell>
        <mxCell id="7" value="GET/DELETE 跳过，POST/PUT 清洗参数" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="180" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="8" value="3. RefererFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="475" y="230" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="9" value="仅保护 /profile/*，校验 allowedDomains" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="235" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="10" value="4. CorsFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="475" y="285" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="11" value="处理跨域 OPTIONS 预检请求" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="290" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="12" value="5. JwtAuthenticationTokenFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="475" y="340" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="13" value="解析 JWT → 获取 uuid → Redis 查 LoginUser → 设置 SecurityContext" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="345" width="320" height="30" as="geometry" />
        </mxCell>

        <!-- Spring Security 层 -->
        <mxCell id="14" value="Spring Security FilterChain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="425" y="470" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="15" value="@EnableMethodSecurity + SessionCreationPolicy.STATELESS" style="text;html=1;align=left;fontSize=12;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="440" y="480" width="420" height="25" as="geometry" />
        </mxCell>
