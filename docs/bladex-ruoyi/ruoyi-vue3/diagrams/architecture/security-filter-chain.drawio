<mxfile host="ruoyi-architecture-analysis">
  <diagram id="security-filter-chain" name="安全过滤器链图">
    <mxGraphModel dx="1422" dy="766" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HTTP 请求入口 -->
        <mxCell id="2" value="HTTP 请求" style="shape=mxgraph.flowchart.start_1;whiteSpace=wrap;html=1;fillColor=#b3e5fc;strokeColor=#0288d1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="575" y="20" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Servlet Filter 链 -->
        <mxCell id="3" value="Servlet Filter 链 (javax.servlet.Filter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="425" y="100" width="450" height="340" as="geometry" />
        </mxCell>

        <mxCell id="4" value="1. RepeatableFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="475" y="120" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="5" value="包装 Request 为可重复读取" style="text;html=1;align=left;fontSize=11;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="125" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="6" value="2. XssFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
