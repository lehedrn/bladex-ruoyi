          <mxGeometry x="360" y="80" width="150" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-user" value="BladeUserDetailService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#d79b00;strokeWidth=1;fillColor=#ffe6cc;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="550" y="80" width="140" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-lock" value="BladeLockHandler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#b85450;strokeWidth=1;fillColor=#f8cecc;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="730" y="80" width="130" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-pwd" value="BladePasswordHandler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#d79b00;strokeWidth=1;fillColor=#ffe6cc;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="900" y="80" width="140" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-token" value="BladeTokenHandler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#d79b00;strokeWidth=1;fillColor=#ffe6cc;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="1060" y="80" width="130" height="720" as="geometry" />
        </mxCell>

        <!-- ===== Step 1: POST /blade-auth/oauth/token ===== -->
        <mxCell id="s1" value="1. POST /blade-auth/oauth/token&#10;(tenantId, username, password,&#10; captchaKey, captchaCode)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#333333;entryX=0;entryY=0.5;" parent="1" source="p-client" target="p-captcha" edge="1">
          <mxGeometry x="140" y="130" as="geometry">
            <mxPoint x="140" y="130" as="sourcePoint" />
            <mxPoint x="180" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 2: preValidation (weak password check) ===== -->
        <mxCell id="s2" value="2. preValidation()&#10;弱密码检查" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" target="p-auth" edge="1">
          <mxGeometry x="320" y="170" as="geometry">
            <mxPoint x="250" y="170" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 3: Account Lock Check ===== -->
        <mxCell id="s3" value="3. validateAccountLock(account)&#10;检查账号锁定状态" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#b85450;fontStyle=1;" parent="1" source="p-auth" target="p-lock" edge="1">
          <mxGeometry x="650" y="210" as="geometry">
            <mxPoint x="650" y="210" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 3.1: Lock -> Redis GET account ===== -->
        <mxCell id="s3a" value="Redis GET&#10;blade:lock:fail:account:{account}" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=9;strokeColor=#d79b00;dashed=1;" parent="1" edge="1">
          <mxGeometry x="700" y="245" as="geometry">
            <mxPoint x="795" y="245" as="sourcePoint" />
            <mxPoint x="860" y="245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="redis-note1" value="Redis Key格式:&#10;blade:lock:fail:account:{account}&#10;blade:lock:fail:ip:{ip}&#10;blade:lock:account:{account}" style="text;html=1;align=left;valign=top;fontSize=9;fontFamily=monospace;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;spacing=3;" parent="1" vertex="1">
          <mxGeometry x="700" y="270" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Step 4: IP Lock Check ===== -->
        <mxCell id="s4" value="4. validateIpLock(ip)&#10;检查IP锁定状态" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#b85450;fontStyle=1;" parent="1" source="p-auth" target="p-lock" edge="1">
          <mxGeometry x="650" y="330" as="geometry">
            <mxPoint x="650" y="330" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 5: Captcha Validation ===== -->
        <mxCell id="s5" value="5. Redis GET 验证验证码&#10;blade:captcha:{captchaKey}" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=10;strokeColor=#d79b00;" parent="1" edge="1">
          <mxGeometry x="210" y="370" as="geometry">
            <mxPoint x="250" y="370" as="sourcePoint" />
            <mxPoint x="180" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 6: loadByUsername ===== -->
        <mxCell id="s6" value="6. loadByUsername(tenantId, account)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" target="p-user" edge="1">
          <mxGeometry x="490" y="410" as="geometry">
            <mxPoint x="510" y="410" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 7: Cache Check + DB ===== -->
        <mxCell id="s7a" value="7a. UserCache 缓存检查&#10;blade:cache:user:{userId}" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=9;strokeColor=#d79b00;dashed=1;" parent="1" edge="1">
          <mxGeometry x="540" y="445" as="geometry">
            <mxPoint x="620" y="445" as="sourcePoint" />
            <mxPoint x="690" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7b" value="7b. 缓存未命中&#10;SELECT * FROM blade_user&#10;WHERE tenant_id=? AND account=?" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#fff2cc;fontSize=9;strokeColor=#b09206;" parent="1" edge="1">
          <mxGeometry x="540" y="495" as="geometry">
            <mxPoint x="620" y="495" as="sourcePoint" />
            <mxPoint x="690" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 8: Return UserInfo ===== -->
        <mxCell id="s8" value="8. 返回 UserInfo&#10;(User + roles + permissions)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=right;verticalAlign=top;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" source="p-user" target="p-auth" edge="1">
          <mxGeometry x="390" y="540" as="geometry">
            <mxPoint x="390" y="540" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 9: Password matches ===== -->
        <mxCell id="s9" value="9. matches(明文, BCrypt哈希)&#10;BCryptPasswordEncoder" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" source="p-auth" target="p-pwd" edge="1">
          <mxGeometry x="800" y="585" as="geometry">
            <mxPoint x="800" y="585" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 10: authValidation (tenant status) ===== -->
        <mxCell id="s10" value="10. authValidation()&#10;验证租户状态 (blade_tenant)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" target="p-auth" edge="1">
          <mxGeometry x="380" y="630" as="geometry">
            <mxPoint x="510" y="630" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 11: Token enhance ===== -->
        <mxCell id="s11" value="11. enhance() 生成 JWT&#10;(user_id, tenant_id, role_id,&#10; dept_id, account)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" target="p-token" edge="1">
          <mxGeometry x="1000" y="670" as="geometry">
            <mxPoint x="510" y="670" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 12: authSuccessful - clear lock ===== -->
        <mxCell id="s12" value="12. authSuccessful()&#10;清除锁定计数" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#82b366;" parent="1" target="p-lock" edge="1">
