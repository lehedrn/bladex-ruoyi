        </mxCell>

        <!-- Source Index -->
        <mxCell id="source-index" value="代码来源索引:&#10;[auth/handler] BladeAuthorizationHandler: preValidation, authValidation, authSuccessful&#10;[auth/handler] BladeLockHandler: validateAccountLock, validateIpLock, clearLock&#10;[auth/handler] BladePasswordHandler: matches(BCryptPasswordEncoder)&#10;[auth/handler] BladeTokenHandler: enhance(JWT生成)&#10;[auth/service] BladeUserDetailService: loadByUsername + UserCache&#10;[auth/granter] CaptchaTokenGranter: grant(token发放)&#10;Redis Key: blade:lock:fail:account:{account}&#10;  blade:lock:fail:ip:{ip} blade:lock:account:{account}&#10;  blade:cache:user:{userId} blade:captcha:{captchaKey}" style="text;html=1;align=left;valign=top;fontSize=9;fontFamily=monospace;fillColor=#f8f8f8;strokeColor=#cccccc;rounded=1;whiteSpace=wrap;spacing=4;" parent="1" vertex="1">
