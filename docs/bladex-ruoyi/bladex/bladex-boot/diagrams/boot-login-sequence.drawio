            <mxPoint x="510" y="715" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s12a" value="Redis DEL&#10;blade:lock:fail:*" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=9;strokeColor=#d79b00;dashed=1;" parent="1" edge="1">
          <mxGeometry x="780" y="745" as="geometry">
            <mxPoint x="795" y="745" as="sourcePoint" />
            <mxPoint x="860" y="745" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 13: Return Token ===== -->
        <mxCell id="s13" value="13. 返回 {access_token,&#10; refresh_token, expire}" style="edgeStyle=orthogonalEdgeStyle;html=1;align=right;verticalAlign=top;labelBackgroundColor=#d5e8d4;fontSize=10;fontStyle=1;strokeColor=#82b366;entryX=0;entryY=0.95;" parent="1" source="p-captcha" target="p-client" edge="1">
          <mxGeometry x="100" y="780" as="geometry">
            <mxPoint x="100" y="780" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

