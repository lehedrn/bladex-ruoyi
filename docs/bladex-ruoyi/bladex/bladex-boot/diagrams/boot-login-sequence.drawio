          <mxGeometry x="100" y="40" width="12" height="12" as="geometry" />
        </mxCell>

        <!-- ===== Participants (Lifelines) ===== -->
        <mxCell id="p-client" value="客户端" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#333333;strokeWidth=1;fillColor=#f5f5f5;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="30" y="80" width="110" height="720" as="geometry" />
        </mxCell>
