<mxfile host="app.diagrams.net" modified="2026-05-21T00:00:00.000Z" agent="Claude Code" version="24.0.0" type="device">
  <diagram id="boot-permission-sequence" name="权限验证时序图">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="BladeX-Boot 权限验证时序图" style="text;html=1;align=center;valign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="350" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Participants ===== -->
        <mxCell id="p-http" value="HTTP请求" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#333333;strokeWidth=1;fillColor=#f5f5f5;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="30" y="80" width="110" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-secure" value="SecureInterceptor" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#82b366;strokeWidth=1;fillColor=#d5e8d4;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="180" y="80" width="140" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-jwt" value="JWT解码" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#6c8ebf;strokeWidth=1;fillColor=#dae8fc;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="360" y="80" width="110" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-perm" value="BladePermissionHandler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#d79b00;strokeWidth=1;fillColor=#ffe6cc;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="510" y="80" width="150" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-cache" value="SysCache(Redis)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#d79b00;strokeWidth=1;fillColor=#ffe6cc;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="700" y="80" width="130" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p-db" value="DB(blade_role_menu/&#10;blade_menu/blade_scope_data)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;rounded=1;shadow=0;comic=0;labelBackgroundColor=none;strokeColor=#666666;strokeWidth=1;fillColor=#f5f5f5;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="870" y="80" width="160" height="720" as="geometry" />
        </mxCell>

        <!-- ===== Step 1: HTTP Request arrives ===== -->
        <mxCell id="s1" value="1. HTTP 请求到达" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#333333;" parent="1" source="p-http" target="p-secure" edge="1">
          <mxGeometry x="140" y="130" as="geometry">
            <mxPoint x="140" y="130" as="sourcePoint" />
            <mxPoint x="180" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 2: Check skip URLs ===== -->
        <mxCell id="s2" value="2. 检查跳过 URL&#10;/blade-auth/**&#10;/doc.html&#10;/swagger-resources/**&#10;/webjars/**, /actuator/**" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=none;fontSize=10;" parent="1" target="p-secure" edge="1">
          <mxGeometry x="200" y="170" as="geometry">
            <mxPoint x="250" y="170" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2a: Skip -> pass -->
        <mxCell id="s2a" value="是 → 直接放行" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#d5e8d4;fontSize=10;strokeColor=#82b366;fontStyle=1;" parent="1" edge="1">
          <mxGeometry x="100" y="240" as="geometry">
            <mxPoint x="250" y="240" as="sourcePoint" />
            <mxPoint x="85" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Extract JWT Token -->
        <mxCell id="s3" value="3. 提取 JWT Token&#10;Header: Blade-Auth" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#6c8ebf;" parent="1" target="p-jwt" edge="1">
          <mxGeometry x="320" y="280" as="geometry">
            <mxPoint x="320" y="280" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 4: JWT decode -->
        <mxCell id="s4" value="4. JWT 解码验证&#10;提取 BladeUser" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=none;fontSize=10;strokeColor=#6c8ebf;" parent="1" target="p-perm" edge="1">
          <mxGeometry x="470" y="320" as="geometry">
            <mxPoint x="470" y="320" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 5: permissionAll -->
        <mxCell id="s5" value="5. permissionAll(requestURI)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;strokeColor=#d79b00;" parent="1" source="p-perm" target="p-cache" edge="1">
          <mxGeometry x="640" y="360" as="geometry">
            <mxPoint x="640" y="360" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 6: Cache check apiScope:role:{roleId} -->
        <mxCell id="s6" value="6. GET apiScope:role:{roleId}&#10;检查 URI scope_path 前缀" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=9;strokeColor=#d79b00;" parent="1" target="p-cache" edge="1">
          <mxGeometry x="680" y="395" as="geometry">
            <mxPoint x="765" y="395" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 6a: Cache miss -> DB -->
        <mxCell id="s6a" value="未命中→DB:&#10;SELECT scope_path&#10;FROM blade_scope_data s&#10;JOIN blade_role_scope rs&#10;ON s.id = rs.scope_id&#10;WHERE rs.role_id = ?" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#fff2cc;fontSize=9;strokeColor=#b09206;" parent="1" target="p-db" edge="1">
          <mxGeometry x="840" y="400" as="geometry">
            <mxPoint x="830" y="400" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 7: hasPermission(code) -->
        <mxCell id="s7" value="7. hasPermission(code)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=none;fontSize=10;strokeColor=#d79b00;" parent="1" target="p-cache" edge="1">
          <mxGeometry x="680" y="480" as="geometry">
            <mxPoint x="660" y="480" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 8: Cache check apiScope:code:{code}:{roleId} -->
        <mxCell id="s8" value="8. GET apiScope:code:{code}:{roleId}" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=9;strokeColor=#d79b00;" parent="1" target="p-cache" edge="1">
          <mxGeometry x="700" y="515" as="geometry">
            <mxPoint x="765" y="515" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s8a" value="未命中→DB:&#10;SELECT FROM blade_scope_data&#10;WHERE scope_code = ?" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#fff2cc;fontSize=9;strokeColor=#b09206;" parent="1" target="p-db" edge="1">
          <mxGeometry x="840" y="520" as="geometry">
            <mxPoint x="830" y="520" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 9: hasMenu(code) recursive -->
        <mxCell id="s9" value="9. hasMenu(code)&#10;递归检查父菜单权限" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=none;fontSize=10;strokeColor=#d79b00;" parent="1" target="p-cache" edge="1">
          <mxGeometry x="680" y="580" as="geometry">
            <mxPoint x="660" y="580" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 10: Cache check apiScope:menu:{code}:{roleId} -->
        <mxCell id="s10" value="10. GET apiScope:menu:{code}:{roleId}" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#ffe6cc;fontSize=9;strokeColor=#d79b00;" parent="1" target="p-cache" edge="1">
          <mxGeometry x="700" y="615" as="geometry">
            <mxPoint x="765" y="615" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s10a" value="未命中→DB:&#10;SELECT FROM blade_menu m&#10;JOIN blade_role_menu rm&#10;ON m.id = rm.menu_id&#10;WHERE rm.role_id = ?&#10;AND m.code = ?" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;labelBackgroundColor=#fff2cc;fontSize=9;strokeColor=#b09206;" parent="1" target="p-db" edge="1">
          <mxGeometry x="840" y="620" as="geometry">
            <mxPoint x="830" y="620" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 11: Result -->
        <mxCell id="s11" value="11. 权限验证结果&#10;放行 或 403 Forbidden" style="edgeStyle=orthogonalEdgeStyle;html=1;align=right;labelBackgroundColor=#d5e8d4;fontSize=10;fontStyle=1;strokeColor=#82b366;" parent="1" source="p-secure" target="p-http" edge="1">
          <mxGeometry x="80" y="740" as="geometry">
            <mxPoint x="80" y="740" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Cache Key Format annotation -->
        <mxCell id="cache-keys" value="缓存 Key 格式:&#10;apiScope:role:{roleId}     → URI scope_path 列表&#10;apiScope:code:{code}:{roleId}→ 按钮/操作权限代码&#10;apiScope:menu:{code}:{roleId}→ 菜单权限树节点&#10;&#10;缓存策略: 角色授权时主动清除&#10;SysCache.clear(roleId) 清除所有相关缓存" style="text;html=1;align=left;valign=top;fontSize=9;fontFamily=monospace;fillColor=#f8f8f8;strokeColor=#cccccc;rounded=1;whiteSpace=wrap;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="10" y="560" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- Source Index -->
        <mxCell id="source-index" value="代码来源索引:&#10;[core-boot] SecureInterceptor: skip URL 检查 + JWT 提取&#10;[common/handler] BladePermissionHandler: permissionAll, hasPermission, hasMenu&#10;[common/cache] SysCache: getScope, getCode, getMenu (Redis缓存)&#10;[system] blade_role_menu, blade_menu, blade_scope_data 表查询" style="text;html=1;align=left;valign=top;fontSize=9;fontFamily=monospace;fillColor=#f8f8f8;strokeColor=#cccccc;rounded=1;whiteSpace=wrap;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="10" y="700" width="320" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
