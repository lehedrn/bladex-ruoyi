        <!-- Permission annotations note -->
        <mxCell id="perm-note" value="@IsAdmin / @IsAdministrator → 自定义 AOP 切面拦截&lt;br&gt;@PreAuthorize(&quot;hasAuthority('xxx')&quot;) → Spring Security SpEL 表达式&lt;br&gt;@PreAuth(menu=&quot;user&quot;) → 自定义权限注解" style="text;html=1;align=left;valign=top;fontSize=10;fontColor=#C62828;spacing=2;" vertex="1" parent="1">
