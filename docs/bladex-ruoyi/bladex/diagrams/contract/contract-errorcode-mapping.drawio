        <mxCell id="risk-group" value="风险点（⚠️）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=14;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="780" y="445" width="560" height="120" as="geometry" />
        </mxCell>

        <mxCell id="risk1" value="1. 后端 R.fail() 在 HTTP 200 下返回 → 拦截器不拦截 → 需业务代码自行判断 code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#C62828" parent="1" vertex="1">
          <mxGeometry x="800" y="460" width="520" height="25" as="geometry" />
        </mxCell>
        <mxCell id="risk2" value="2. validateStatus 设置 200-500 为有效 → HTTP 500 不会触发网络错误 → 依赖业务代码处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#C62828" parent="1" vertex="1">
          <mxGeometry x="800" y="485" width="520" height="25" as="geometry" />
        </mxCell>
        <mxCell id="risk3" value="3. 403 无差异化处理 → 权限不足时与一般错误同等处理 → 用户体验不佳" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#C62828" parent="1" vertex="1">
          <mxGeometry x="800" y="510" width="520" height="25" as="geometry" />
        </mxCell>
        <mxCell id="risk4" value="4. 后端错误消息硬编码中文 → 前端国际化（i18n）无法翻译 → 多语言场景下显示中文" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#C62828" parent="1" vertex="1">
          <mxGeometry x="800" y="535" width="520" height="25" as="geometry" />
        </mxCell>

