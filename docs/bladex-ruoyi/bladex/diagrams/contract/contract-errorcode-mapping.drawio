          <mxGeometry x="50" y="305" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be-500" value="500 Server Error\n服务异常/运行时异常" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#E53935;fontSize=10" parent="1" vertex="1">
