          <mxGeometry x="420" y="90" width="300" height="480" as="geometry" />
        </mxCell>

        <mxCell id="map1" value="✅ 响应拦截器\n!=200 → ElMessage.error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10" parent="1" vertex="1">
