          <mxGeometry x="440" y="175" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="map3" value="✅ >2000 → 显示 error_description\n其他 → ElMessage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10" parent="1" vertex="1">
          <mxGeometry x="440" y="240" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="map4" value="✅ 自动刷新 Token\n刷新失败 → 清除 → 跳转 /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=10" parent="1" vertex="1">
          <mxGeometry x="440" y="305" width="200" height="50" as="geometry" />
